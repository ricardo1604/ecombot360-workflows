o: score 1, enojo, queja fuerte, pide reembolso\n- aspectos comunes: calidad, precio, durabilidad, diseño, batería, sonido, conectividad, empaque, soporte, entrega"}]},"builtInTools":{},"options":{}},"type":"@n8n/n8n-nodes-langchain.openAi","typeVersion":2.1,"position":[672,-96],"id":"c36365a1-3246-4436-8db8-6d01c3876670","name":"Analizar Sentimiento","credentials":{"openAiApi":{"id":"LPi4kLkkOTLFWRkU","name":"OpenAi account"}}},{"parameters":{},"type":"n8n-nodes-base.noOp","typeVersion":1,"position":[736,96],"id":"a1e8d3c9-0e44-47d2-ac6c-699f3cae748d","name":"No hay reseñas que analizar"},{"parameters":{"documentId":{"__rl":true,"value":"14tSJNCxXjfLLIyKqGTgzmQ5lejztUi8GdGjNzb4UYrw","mode":"list","cachedResultName":"EcomBot360Backend","cachedResultUrl":"https://docs.google.com/spreadsheets/d/14tSJNCxXjfLLIyKqGTgzmQ5lejztUi8GdGjNzb4UYrw/edit?usp=drivesdk"},"sheetName":{"__rl":true,"value":275590917,"mode":"list","cachedResultName":"Resenas","cachedResultUrl":"https://docs.google.com/spreadsheets/d/14tSJNCxXjfLLIyKqGTgzmQ5lejztUi8GdGjNzb4UYrw/edit#gid=275590917"},"filtersUI":{"values":[{"lookupColumn":"procesado","lookupValue":"false"}]},"options":{}},"type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[224,0],"id":"95879dbc-6c8c-4098-89e4-891abade831a","name":"Leer Reseñas","credentials":{"googleSheetsOAuth2Api":{"id":"TcYUp8Nmwj5RufHc","name":"Google Sheets account"}}},{"parameters":{"jsCode":"// === PARSEAR SENTIMIENTO — TODOS LOS ITEMS ===\nconst items = $input.all();\nconst originales = $('Leer Reseñas').all();\nconst results = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const input = items[i].json;\n  const original = originales[i]?.json || {};\n\n  let responseText = '';\n  if (input.output) {\n    for (const block of input.output) {\n      if (block.content) {\n        for (const content of block.content) {\n          if (content.type === 'output_text' && content.text) {\n            responseText = content.text;\n            break;\n          }\n        }\n      }\n      if (responseText) break;\n    }\n  } else if (input.message?.content) {\n    responseText = input.message.content;\n  } else if (input.text) {\n    responseText = input.text;\n  }\n\n  responseText = responseText.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n\n  let analysis;\n  try {\n    analysis = JSON.parse(responseText);\n  } catch (e) {\n    analysis = {\n      sentimiento: 'neutro',\n      score_sentimiento: 3,\n      aspectos: [],\n      resumen: 'Error al analizar'\n    };\n  }\n\n  const aspectosStr = analysis.aspectos\n    .map(a => `${a.aspecto}: ${a.sentimiento}`)\n    .join(', ');\n\n  results.push({\n    json: {\n      resena_id: original.resena_id,\n      producto_nombre: original.producto_nombre,\n      rating: original.rating,\n      texto_resena: original.texto_resena,\n      sentimiento_ia: analysis.sentimiento,\n      score_sentimiento: analysis.score_sentimiento,\n      aspectos_ia: aspectosStr,\n      resumen: analysis.resumen\n    }\n  });\n}\n\nreturn results;"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1024,-96],"id":"d1834369-67a2-41c5-a689-bc15915f9346","name":"Parsear Sentimiento"},{"parameters":{"operation":"update","documentId":{"__rl":true,"value":"14tSJNCxXjfLLIyKqGTgzmQ5lejztUi8GdGjNzb4UYrw","mode":"list","cachedResultName":"EcomBot360Backend","cachedResultUrl":"https://docs.google.com/spreadsheets/d/14tSJNCxXjfLLIyKqGTgzmQ5lejztUi8GdGjNzb4UYrw/edit?usp=drivesdk"},"sheetName":{"__rl":true,"value":275590917,"mode":"list","cachedResultName":"Resenas","cachedResultUrl":"https://docs.google.com/spreadsheets/d/14tSJNCxXjfLLIyKqGTgzmQ5lejztUi8GdGjNzb4UYrw/edit#gid=275590917"},"columns":{"mappingMode":"defineBelow","value":{"resena_id":"={{ $json.resena_id }}","sentimiento_ia":"={{ $json.sentimiento_ia }}","aspectos_ia":"={{ $json.aspectos_ia }}","procesado":"=true"},"matchingColumns":["resena_id"],"schema":[{"id":"resena_id","displayName":"resena_id","required":false,"default