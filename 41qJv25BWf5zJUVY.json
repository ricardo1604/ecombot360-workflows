HBOARD v2 ===\nconst items = $('Parsear Sentimiento').all();\n\nconst counts = {\n  muy_positivo: 0,\n  positivo: 0,\n  neutro: 0,\n  negativo: 0,\n  muy_negativo: 0\n};\n\nlet peorProducto = { nombre: 'N/A', score: 999 };\nlet mejorProducto = { nombre: 'N/A', score: 0 };\n\nfor (const item of items) {\n  const s = item.json.sentimiento_ia;\n  if (counts[s] !== undefined) counts[s]++;\n  \n  const score = item.json.score_sentimiento || 3;\n  if (score < peorProducto.score) {\n    peorProducto = { nombre: item.json.producto_nombre, score: score };\n  }\n  if (score > mejorProducto.score) {\n    mejorProducto = { nombre: item.json.producto_nombre, score: score };\n  }\n}\n\nconst total = items.length;\nconst totalNegativo = counts.negativo + counts.muy_negativo;\nconst totalPositivo = counts.positivo + counts.muy_positivo;\nconst pctNegativo = total > 0 ? Math.round((totalNegativo / total) * 100) : 0;\nconst pctPositivo = total > 0 ? Math.round((totalPositivo / total) * 100) : 0;\n\nconst alertaRequerida = pctNegativo > 20;\n\nreturn {\n  json: {\n    fecha_analisis: new Date().toISOString().split('T')[0],\n    total_resenas: total,\n    muy_positivo: counts.muy_positivo,\n    positivo: counts.positivo,\n    neutro: counts.neutro,\n    negativo: counts.negativo,\n    muy_negativo: counts.muy_negativo,\n    pct_positivo: pctPositivo + '%',\n    pct_negativo: pctNegativo + '%',\n    nps_promedio: total > 0 ? (items.reduce((sum, i) => sum + (i.json.score_sentimiento || 3), 0) / total).toFixed(1) : '0',\n    producto_top: mejorProducto.nombre,\n    producto_peor: peorProducto.nombre,\n    alerta_enviada: alertaRequerida ? 'sí' : 'no',\n    alerta_requerida: alertaRequerida\n  }\n};"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1472,-96],"id":"5abfcd55-cb5e-45b6-a0d8-eb922755f551","name":"Calcular Métricas"},{"parameters":{"operation":"append","documentId":{"__rl":true,"value":"14tSJNCxXjfLLIyKqGTgzmQ5lejztUi8GdGjNzb4UYrw","mode":"list","cachedResultName":"Eco